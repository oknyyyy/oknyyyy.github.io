---
import BaseLayout from '@layouts/BaseLayout.astro';
import { formatDate, type Post } from '@lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;
---

<BaseLayout title={title} description={description} type="article">
  <article class="container-page pt-12 pb-16 md:pt-16 md:pb-24">
    <header class="mb-10 border-b border-line pb-8">
      <a href="/blog/" class="text-sm text-muted hover:text-accent">&larr; Blog</a>
      <h1 class="mt-4 text-3xl md:text-4xl">{title}</h1>
      <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {
          updatedDate && (
            <span>
              更新: <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
            </span>
          )
        }
        {
          tags.length > 0 && (
            <ul class="flex flex-wrap gap-2">
              {tags.map((tag) => (
                <li class="rounded-full bg-accent-soft px-3 py-0.5 text-xs text-accent-hover">
                  {tag}
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </header>

    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
