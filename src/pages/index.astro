---
import BaseLayout from '@layouts/BaseLayout.astro';
import SocialLinks from '@components/SocialLinks.astro';
import { site } from '@data/site';

const about = [
  'Webアプリケーションのフロントエンドからバックエンド、インフラまで一通り手がけます。',];

const skills = [
  { category: 'Frontend', items: ['TypeScript', 'React', 'Tailwind CSS'] },
  { category: 'Backend', items: ['Java', 'Go', 'MySQL', 'Spring Boot'] },
  { category: 'Infrastructure', items: ['AWS', 'Docker'] },
];
---

<BaseLayout>
  <!-- Hero -->
  <section class="container-page pt-16 pb-12 md:pt-24 md:pb-16">
    <h1 class="text-5xl md:text-6xl">{site.name}<span class="text-accent">.</span></h1>
    <p class="mt-3 font-medium text-accent md:text-lg">{site.role}</p>
  </section>

  <!-- About -->
  <section class="container-page pb-12 md:pb-16" aria-labelledby="about">
    <h2 id="about" class="mb-4 text-sm font-semibold tracking-widest text-muted uppercase">
      About
    </h2>
    <div class="space-y-4 text-base md:text-lg">
      {about.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <!-- Links -->
  <section class="container-page pb-12 md:pb-16" aria-labelledby="links">
    <h2 id="links" class="mb-4 text-sm font-semibold tracking-widest text-muted uppercase">
      Links
    </h2>
    <SocialLinks variant="card" />
  </section>

  <!-- Skills -->
  <section class="container-page pb-16 md:pb-24" aria-labelledby="skills">
    <h2 id="skills" class="mb-4 text-sm font-semibold tracking-widest text-muted uppercase">
      Skills
    </h2>
    <dl class="divide-y divide-line rounded-card border border-line">
      {
        skills.map((group) => (
          <div class="flex flex-col gap-2 p-4 sm:flex-row sm:items-baseline sm:gap-6">
            <dt class="w-36 shrink-0 text-sm font-semibold">{group.category}</dt>
            <dd class="flex flex-wrap gap-2">
              {group.items.map((item) => (
                <span class="rounded-full bg-accent-soft px-3 py-0.5 text-sm text-accent-hover">
                  {item}
                </span>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>
</BaseLayout>
