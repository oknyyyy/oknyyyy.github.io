---
import BaseLayout from '@layouts/BaseLayout.astro';
import PostList from '@components/PostList.astro';
import { getPosts } from '@lib/posts';

const posts = await getPosts();
---

<BaseLayout title="Blog" description="oknyyyyの技術ブログ。開発やインフラについてのメモ。">
  <section class="container-page pt-12 pb-16 md:pt-16 md:pb-24">
    <h1 class="text-3xl md:text-4xl">Blog</h1>
    <p class="mt-3 text-muted">開発やインフラについて、学んだことや作ったものを書いています。</p>
    <div class="mt-8 border-t border-line">
      <PostList posts={posts} />
    </div>
  </section>
</BaseLayout>
