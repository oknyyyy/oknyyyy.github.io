---
import { formatDate, type Post } from '@lib/posts';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="text-muted">まだ記事はありません。</p>
  ) : (
    <ul class="divide-y divide-line">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}/`} class="group block py-6">
            <time datetime={post.data.pubDate.toISOString()} class="text-sm text-muted">
              {formatDate(post.data.pubDate)}
            </time>
            <h2 class="mt-1 text-lg md:text-xl group-hover:text-accent">{post.data.title}</h2>
            <p class="mt-2 text-sm text-muted">{post.data.description}</p>
            {post.data.tags.length > 0 && (
              <ul class="mt-3 flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <li class="rounded-full bg-accent-soft px-3 py-0.5 text-xs text-accent-hover">
                    {tag}
                  </li>
                ))}
              </ul>
            )}
          </a>
        </li>
      ))}
    </ul>
  )
}
